[Unit]
Description=Remote Connect MCP machine agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/
EnvironmentFile=/etc/remote-connect-mcp-agent/agent.env
ExecStart=/opt/remote-connect-mcp-agent/rcm-agent
Restart=always
RestartSec=3
# Leave no-timeout durable task children alive while the Agent is restarted;
# the Agent explicitly kills attached (timed) tasks during a graceful stop.
KillMode=process
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
# Keep the 1C/1G-class host usable even when a browser adapter misbehaves.
# Browser/Desktop adapters may need short bursts; the high/maximum pair leaves
# headroom while still making runaway task fan-out fail closed at systemd.
CPUAccounting=true
MemoryAccounting=true
IOAccounting=true
TasksAccounting=true
LimitNOFILE=8192
TasksMax=256
# Desktop companion runs in the interactive user session and is deliberately
# outside this service cgroup; its own connection/launch caps apply there.
CPUQuota=100%
MemoryHigh=512M
MemoryMax=768M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
