[Unit]
Description=Remote Connect MCP machine agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/
EnvironmentFile=/etc/remote-connect-mcp-agent/agent.env
ExecStart=/opt/remote-connect-mcp-agent/rcm-agent
Restart=always
RestartSec=3
# Leave no-timeout durable task children alive while the Agent is restarted;
# the Agent explicitly kills attached (timed) tasks during a graceful stop.
KillMode=process
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
# Account resource use without imposing a hard memory cap.  Browser/Desktop
# adapters may need short bursts, while these limits still make runaway task
# fan-out visible to systemd and keep file/task descriptors bounded.
CPUAccounting=true
MemoryAccounting=true
IOAccounting=true
TasksAccounting=true
LimitNOFILE=8192
TasksMax=256
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
