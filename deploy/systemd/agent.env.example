REMOTE_CONNECT_MCP_AGENT_CENTER_URL=https://remote-connect-mcp-agent.example.invalid
# Java installer consumes the one-time token before enabling the service;
# do not keep REMOTE_CONNECT_MCP_AGENT_ENROLLMENT_TOKEN in this long-lived file.
REMOTE_CONNECT_MCP_AGENT_NAME=replace-with-stable-machine-name
REMOTE_CONNECT_MCP_AGENT_HOST_ID=replace-with-physical-host-id
REMOTE_CONNECT_MCP_AGENT_DEFAULT_CWD=/
REMOTE_CONNECT_MCP_AGENT_SCOPE_MODE=unrestricted
REMOTE_CONNECT_MCP_AGENT_WORKSPACE_ROOT=
REMOTE_CONNECT_MCP_AGENT_CAPABILITIES=command,durable_tasks
REMOTE_CONNECT_MCP_AGENT_VERSION=dev
REMOTE_CONNECT_MCP_AGENT_BROWSER_ADAPTER=
# Optional sibling Native supervisor (installed by install-agent.sh when a
# browser bundle is supplied). If empty, command-agent runs the adapter
# directly for backward compatibility.
REMOTE_CONNECT_MCP_AGENT_BROWSER_BINARY=
REMOTE_CONNECT_MCP_AGENT_DESKTOP_ENABLED=false
REMOTE_CONNECT_MCP_AGENT_DESKTOP_BINARY=
# Headless desktop-launch fallback cap. The interactive companion has its own
# connection/launch caps; this prevents a missing user session from spawning
# an unbounded number of persistent processes.
REMOTE_CONNECT_MCP_AGENT_DESKTOP_MAX_LAUNCHED_PROCESSES=16
REMOTE_CONNECT_MCP_AGENT_STATE_DIR=/var/lib/remote-connect-mcp-agent
REMOTE_CONNECT_MCP_AGENT_MAX_CONCURRENCY=1
# Browser adapters are heavier than command tasks. This cap is independent of
# MAX_CONCURRENCY and is clamped to that value (1-8; default min(2, max)).
REMOTE_CONNECT_MCP_AGENT_MAX_BROWSER_WORKERS=1
REMOTE_CONNECT_MCP_AGENT_MAX_OUTPUT_BYTES=67108864
# Aggregate ordinary-task spool ceiling; defaults to min(256 MiB, concurrency x per-task),
# but never below MAX_OUTPUT_BYTES so one task remains fully usable.
REMOTE_CONNECT_MCP_AGENT_MAX_AGGREGATE_OUTPUT_BYTES=67108864
# Required for Center-controlled self-upgrade. Keep this path stable across releases.
REMOTE_CONNECT_MCP_AGENT_BINARY_PATH=/opt/remote-connect-mcp-agent/rcm-agent
REMOTE_CONNECT_MCP_AGENT_SERVICE_NAME=remote-connect-mcp-agent
