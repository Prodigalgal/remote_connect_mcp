# Required MCP authentication.
REMOTE_CONNECT_MCP_TOKEN=replace-with-a-fixed-bearer-token

# Set to 1 to create/reuse the Tunnel, configure ingress, upsert DNS,
# fetch the Tunnel Token, and start cloudflared automatically.
REMOTE_CONNECT_MCP_CF_AUTOPROVISION=1
CLOUDFLARE_API_TOKEN=replace-with-a-scoped-cloudflare-api-token
REMOTE_CONNECT_MCP_PUBLIC_HOSTNAME=remote-connect-mcp.example.com
REMOTE_CONNECT_MCP_TUNNEL_NAME=

# Optional. With Zone Read permission, all three values may be empty and the
# program discovers the longest matching zone from the public hostname.
CLOUDFLARE_ZONE_NAME=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# Manual Named Tunnel fallback when auto-provisioning is 0.
REMOTE_CONNECT_MCP_TUNNEL_TOKEN=
REMOTE_CONNECT_MCP_PUBLIC_URL=

REMOTE_CONNECT_MCP_QUICK_TUNNEL=0
REMOTE_CONNECT_MCP_DEFAULT_CWD=
REMOTE_CONNECT_MCP_HOST=127.0.0.1
REMOTE_CONNECT_MCP_PORT=8765
