# Runtime image assembled from a Native Image bundle produced by the
# architecture-matched GitHub Actions job. No compiler is present here.
FROM debian:13-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 65532 --no-create-home rcm

COPY . /opt/rcm-agent/
RUN chmod 0755 /opt/rcm-agent/rcm-agent
USER 65532:65532
ENTRYPOINT ["/opt/rcm-agent/rcm-agent", "--run"]
