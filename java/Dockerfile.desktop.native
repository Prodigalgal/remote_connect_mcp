# Build the interactive AWT companion separately from the headless command
# Agent.  This keeps desktop libraries out of the command Agent image/artifact.
ARG BUILDER_IMAGE=ghcr.io/graalvm/native-image-community:25@sha256:0d936f32bb8acb5bc60c41b33e05f064d7a6aaf36b726538296c54949bd4a3c0
FROM ${BUILDER_IMAGE} AS build
ARG RCM_CI_BUILD=false
ARG RCM_NATIVE_MARCH=compatibility
WORKDIR /src
RUN test "$RCM_CI_BUILD" = "true" || (echo "Native Image Docker builds are GitHub Actions-only" >&2 && exit 2)
ENV GITHUB_ACTIONS=${RCM_CI_BUILD}
COPY . .
RUN chmod +x ./gradlew && ./gradlew :desktop:nativeCompile -PnativeMarch="$RCM_NATIVE_MARCH" --no-daemon --no-parallel

FROM scratch AS artifact
COPY --from=build /src/desktop/build/native/nativeCompile/ /
