# Runtime image assembled from a Native Image bundle produced by the
# architecture-matched GitHub Actions job. This file intentionally contains no
# compiler or Gradle stage: target hosts must never compile Native Image.
FROM debian:13-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 65532 --no-create-home rcm

COPY . /opt/rcm-center/
RUN chmod 0755 /opt/rcm-center/rcm-center
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/opt/rcm-center/rcm-center"]
